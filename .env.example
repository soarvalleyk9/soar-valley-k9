# Copy to .env.local for your own computer. On Netlify, add these under
# Site configuration → Environment variables, then redeploy.
# Never commit real values. This file is the list of names only.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys. Sending uses the verified domain.
RESEND_API_KEY=
EMAIL_FROM=Soar Valley K9 <noreply@securepaddocksuk.co.uk>
EMAIL_REPLY_TO=soarvalley.k9@outlook.com

# Owner alerts (new bookings, "customer says paid", reminders, digest)
OWNER_EMAIL=soarvalley.k9@outlook.com

# Public site address, no trailing slash. Used in email links.
# After the custom domain is attached this should be the live address.
NEXT_PUBLIC_SITE_URL=https://www.securepaddocksuk.co.uk

# Only needed if you use the Supabase cron fallback in supabase/cron.sql.
# Invent a long random password and use the same value in the SQL.
CRON_SECRET=

# Optional. Phone alerts on the owner's home-screen admin.
# Leave blank to use email only. See SETUP.md.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soarvalley.k9@outlook.com
